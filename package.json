{
  "name": "trend-coach-cloud",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch --import tsx src/index.ts",
    "dev:admin": "vite --config web/admin/vite.config.ts",
    "build": "tsc -p tsconfig.build.json && vite build --config web/admin/vite.config.ts",
    "build:server": "tsc -p tsconfig.build.json",
    "build:admin": "vite build --config web/admin/vite.config.ts",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc --noEmit && tsc -p web/admin/tsconfig.json --noEmit",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "migrate": "node --env-file-if-exists=.env --import tsx scripts/migrate.ts",
    "seed": "node --env-file-if-exists=.env --import tsx scripts/seed.ts",
    "test": "node --env-file-if-exists=.env --import tsx --test --test-concurrency=1 test/*.test.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.0",
    "@fastify/static": "^10.1.8",
    "fastify": "^5.0.0",
    "pg": "^8.13.0",
    "prom-client": "^15.1.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.2.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^7.3.7",
    "yaml": "^2.6.0"
  }
}
