# 复制为 .env 后按需修改；.env 不入库。
APP_ENV=local
HOST=127.0.0.1
PORT=3939
PUBLIC_BASE_URL=http://127.0.0.1:3939
DATABASE_URL=postgres://trend_coach:trend_coach@127.0.0.1:5432/trend_coach
TEST_DATABASE_URL=postgres://trend_coach:trend_coach@127.0.0.1:5432/trend_coach_test
LOG_LEVEL=info

# 本地默认值；staging/production 必须显式设置，且不得使用这两个值。
METRICS_TOKEN=local-metrics-token
MEDIA_SIGNING_SECRET=local-media-signing-secret

# 首个管理员：仅当库中没有 active admin 时创建；两项必须同时配置。
# 密码至少 12 字符；创建后从环境中移除。
# BOOTSTRAP_ADMIN_USERNAME=admin01
# BOOTSTRAP_ADMIN_PASSWORD=

# 本地媒体（可选）：指向含 hls/index.m3u8 的目录；生产走 CDN，不设此项。
# MEDIA_LOCAL_DIR=../dsh-plugin-trend-coach/spike/media

# 令牌、后台会话与播放会话 TTL（秒）。
ACCESS_TTL_SECONDS=900
REFRESH_TTL_SECONDS=2592000
DEVICE_CODE_TTL_SECONDS=300
DEVICE_POLL_INTERVAL_SECONDS=2
SESSION_TTL_SECONDS=43200
INVITE_TTL_SECONDS=604800
PLAYBACK_SESSION_TTL_SECONDS=600
PLAYBACK_MAX_CONCURRENT=5

# 检索：未配置 embedding 时仅词法召回。
# 召回阈值只决定候选；引用置信阈值过滤偶然命中，低于它按未覆盖处理。
SEARCH_MIN_SIMILARITY=0.05
SEARCH_MIN_CONFIDENCE=0.15
RRF_K=60
# EMBEDDING_BASE_URL=https://embedding.example.com/v1
# EMBEDDING_MODEL=text-embedding-3-large
# EMBEDDING_API_KEY=

RATE_LIMIT_SEARCH_PER_MINUTE=120
RATE_LIMIT_DEVICE_CODE_PER_MINUTE=10
RATE_LIMIT_DEVICE_APPROVE_PER_MINUTE=10
RATE_LIMIT_EVENTS_PER_MINUTE=120
RATE_LIMIT_PROGRESS_PER_MINUTE=120
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_INVITE_PER_MINUTE=10
RATE_LIMIT_ASR_PER_MINUTE=20

# 语音转写（M4.2，MiniMax）。密钥只放云端环境变量；staging/production 缺失会阻止启动。
# 显式设置 ASR_BASE_URL 时也必须同时配置 ASR_API_KEY。
# ASR_BASE_URL=https://api.minimaxi.com
# ASR_API_KEY=
ASR_MODEL=asr-1.0
ASR_TIMEOUT_MS=30000
ASR_LONG_TIMEOUT_MS=600000

# 视频→课程管线（M1）。默认关闭；关闭时管理端管线接口返回 503。
PIPELINE_ENABLED=false
# 持久化数据统一放 workspace/（已 gitignore）。源文件/工作区与对外 HLS
# 必须在同一挂载点；设置 MEDIA_LOCAL_DIR 时 PIPELINE_HLS_DIR 必须与它相同。
PIPELINE_STORAGE_DIR=./workspace/pipeline/storage
PIPELINE_HLS_DIR=./workspace/pipeline/hls
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
PIPELINE_MAX_UPLOAD_BYTES=2147483648
PIPELINE_MAX_SOURCE_SECONDS=14400
PIPELINE_MAX_CONCURRENT_JOBS=1
PIPELINE_ASR_CONCURRENCY=2
PIPELINE_LLM_CONCURRENCY=2
PIPELINE_POLL_INTERVAL_MS=2000
PIPELINE_HEARTBEAT_MS=10000
PIPELINE_STALE_JOB_MS=120000
PIPELINE_MAX_ATTEMPTS=3
PIPELINE_FFMPEG_TIMEOUT_MS=7200000
PIPELINE_AUDIO_TIMEOUT_MS=600000
TRANSCRIPT_SEGMENT_MAX_SEC=30
SEGMENT_DRAFT_MAX_SEC=120
GENERATION_WINDOW_SEC=600
GENERATION_MIN_CONFIDENCE=0.6
GENERATION_MAX_WINDOWS=24
GENERATION_MAX_KPS=80
GENERATION_MAX_ARTICLES=80
RATE_LIMIT_PIPELINE_PER_MINUTE=30

# 内容生产 LLM（仅管理端草稿生成）。OpenAI 兼容 /chat/completions。
# 非 local 必须 HTTPS；base/model 成对配置，base 非本机时必须同时提供 API key。
# CONTENT_LLM_BASE_URL=https://api.example.com/v1
# CONTENT_LLM_MODEL=
# CONTENT_LLM_API_KEY=
CONTENT_LLM_TIMEOUT_MS=120000
CONTENT_LLM_TEMPERATURE=0.2
CONTENT_LLM_MAX_TOKENS=8192
CONTENT_LLM_MAX_INPUT_CHARS=120000
