# 复制为 .env 后按需修改；.env 不入库。
APP_ENV=local
HOST=127.0.0.1
PORT=3939
PUBLIC_BASE_URL=http://127.0.0.1:3939
DATABASE_URL=postgres://trend_coach:trend_coach@127.0.0.1:5432/trend_coach
TEST_DATABASE_URL=postgres://trend_coach:trend_coach@127.0.0.1:5432/trend_coach_test
LOG_LEVEL=info

# 本地默认值；staging/production 必须显式设置，且不得使用这两个值。
CONSOLE_TOKEN=local-console-token
MEDIA_SIGNING_SECRET=local-media-signing-secret

# 本地媒体（可选）：指向含 hls/index.m3u8 的目录；生产走 CDN，不设此项。
# MEDIA_LOCAL_DIR=../dsh-plugin-trend-coach/spike/media

# 令牌与播放会话 TTL（秒），当前为临时取值，账号体系定稿后同步文档。
ACCESS_TTL_SECONDS=900
REFRESH_TTL_SECONDS=2592000
DEVICE_CODE_TTL_SECONDS=300
DEVICE_POLL_INTERVAL_SECONDS=2
PLAYBACK_SESSION_TTL_SECONDS=600
PLAYBACK_MAX_CONCURRENT=5

# 检索：未配置 embedding 时仅词法召回。
# 召回阈值只决定候选；引用置信阈值过滤偶然命中，低于它按未覆盖处理。
SEARCH_MIN_SIMILARITY=0.05
SEARCH_MIN_CONFIDENCE=0.15
RRF_K=60
# EMBEDDING_BASE_URL=https://embedding.example.com/v1
# EMBEDDING_MODEL=text-embedding-3-large
# EMBEDDING_API_KEY=

RATE_LIMIT_SEARCH_PER_MINUTE=120
RATE_LIMIT_DEVICE_CODE_PER_MINUTE=10
RATE_LIMIT_EVENTS_PER_MINUTE=120
